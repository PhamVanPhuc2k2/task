    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0"
  },
  "_comment_overrides": "js-yaml <4.3.1 có lỗi tiêu tốn CPU bậc hai khi phân tích !!omap (GHSA-5p4m-2wfm-xmqj). Nó đi vào qua openapi-typescript -> @redocly/openapi-core, mà bản mới nhất của openapi-typescript vẫn ghim bản cũ. Ép nâng ở đây; bỏ dòng này khi thượng nguồn tự nâng. Xem README mục 1.9.",
