# ─────────────────────────────────────────────────────
# Biến môi trường cho Docker Compose (hạ tầng).
# Cấu hình của Laravel nằm ở backend/.env
# Cấu hình của Next.js nằm ở frontend/.env.local
#
# Chép file này thành .env rồi chỉnh theo máy của bạn.
# ─────────────────────────────────────────────────────

# Cổng mở ra máy host
APP_PORT=8000
DB_PORT=3306
REDIS_PORT=6379

# MySQL
DB_DATABASE=task_management
DB_USERNAME=app
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# ── Tốc độ backend khi dev ───────────────────────────
# 1 = sửa mã PHP là thấy ngay, nhưng trên bind mount Windows mỗi request tốn
#     khoảng 1,5 giây (OPcache phải kiểm dấu thời gian ~670 file mỗi lần).
# 0 = request còn khoảng 100ms; đổi lại sửa mã PHP xong phải chạy:
#       docker compose exec app kill -USR2 1
# Cách xử lý triệt để: chuyển mã nguồn vào hệ tệp WSL2 — xem README.
OPCACHE_VALIDATE_TIMESTAMPS=1

# ═════════════════════════════════════════════════════
# CHỈ CHO PRODUCTION (docker-compose.prod.yml)
# ═════════════════════════════════════════════════════
# Sáu biến dưới đây không dùng khi chạy dev. Thiếu bất kỳ cái nào thì
# `docker compose -f docker-compose.prod.yml` từ chối khởi động — cố ý, vì
# một máy chủ production chạy với mật khẩu mặc định còn tệ hơn là không chạy.

# Cổng nginx của Explus mở ra máy chủ.
#
# KHÔNG dùng 80 hay 443 nếu máy đã có web server khác: để nguyên 8080 rồi cho
# nginx sẵn có chuyển tiếp vào đây. Kiểm cổng trống bằng: ss -tlnp | grep 8080
APP_PORT=8080

# Tag của image. deploy.sh tự đặt theo commit; chỉ khai ở đây để chạy tay được.
APP_IMAGE=explus/app:latest
FRONTEND_IMAGE=explus/frontend:latest

# Tài khoản riêng cho bài diễn tập phục hồi sao lưu.
#
# Tách khỏi tài khoản ứng dụng có lý do: tài khoản ứng dụng KHÔNG có quyền
# CREATE DATABASE (đúng như vậy), nên nó không phục hồi thử được. Xem
# docker/backup/restore-drill.sh
DRILL_DB_USERNAME=restore_drill
DRILL_DB_PASSWORD=

# Khoá CÔNG KHAI age để mã hoá bản sao lưu.
#
# Sinh bằng: docker run --rm alpine sh -c "apk add -q age && age-keygen"
# Dán dòng `public key:` vào đây. Dòng `AGE-SECRET-KEY-...` là khoá BÍ MẬT —
# cất ở nơi khác máy chủ này, vì mất nó là mất luôn mọi bản sao lưu.
BACKUP_AGE_PUBLIC_KEY=

BACKUP_RETENTION_DAYS=30

