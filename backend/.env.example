APP_NAME=Explus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Múi giờ & ngôn ngữ ───────────────────────────────
# UTC ở mọi tầng lưu trữ. Việc đổi sang giờ Việt Nam chỉ làm ở tầng trình bày.
# Xem README, mục "Quy ước dữ liệu, thời gian & tiền tệ".
APP_TIMEZONE=UTC
# Múi giờ dùng để hiển thị và để suy ra "ngày làm việc".
APP_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Cơ sở dữ liệu ────────────────────────────────────
# Tên host "mysql" là tên service trong docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=task_management
DB_USERNAME=app
DB_PASSWORD=secret

# ── Redis: queue, cache, session ─────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
# Phút KHÔNG hoạt động thì hết phiên (mỗi request làm mới bộ đếm). Xem README
# mục 1.9.
SESSION_LIFETIME=120
# Đặt tên cookie cố định: mặc định Laravel suy ra từ APP_NAME, mà APP_NAME
# tiếng Việt có dấu sẽ cho ra tên khó đoán. Frontend (src/proxy.ts) đọc đúng
# tên này để biết đã đăng nhập hay chưa.
SESSION_COOKIE=explus_session
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
# Bắt buộc bật khi lên production chạy HTTPS. Để false lúc dev vì localhost
# chạy http — bật lên thì trình duyệt không gửi cookie và không ai đăng nhập được.
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# ── Sanctum: xác thực SPA ────────────────────────────
# Domain của frontend Next.js. Không dùng "*" — xem README mục 1.9 Bảo mật.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ── Tài khoản quản trị đầu tiên ──────────────────────
# Dùng bởi AdminUserSeeder. Để trống ADMIN_PASSWORD thì seeder sinh mật khẩu
# ngẫu nhiên và in ra màn hình đúng một lần.
ADMIN_NAME="Quản trị hệ thống"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Lưu trữ tệp ──────────────────────────────────────
# Mặc định là local khi dev; đặt thành r2 khi có thông tin bucket thật.
FILESYSTEM_DISK=local

# Cloudflare R2. R2 không hỗ trợ ACL nên disk cấu hình visibility = null.
#
# Lấy ở dash.cloudflare.com → R2 → API → "Create Account API token" (KHÔNG
# phải User API token: loại đó chết theo tài khoản cá nhân, người tạo nghỉ
# việc là ứng dụng mất quyền vào toàn bộ ảnh). Quyền phải là
# **Object Read & Write** — chỉ Read thì đăng nhập vào bucket được nhưng mọi
# lần tải ảnh lên đều AccessDenied. Giới hạn token vào đúng một bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dạng https://<ACCOUNT_ID>.r2.cloudflarestorage.com — không kèm tên bucket.
R2_ENDPOINT=
# Custom domain gắn vào bucket, dùng để phát URL công khai. Để trống thì
# hệ thống chỉ phát presigned URL có hạn.
R2_PUBLIC_URL=

# Nơi lưu tệp đính kèm của bình luận (mục 1.5). Khi dev để 'public' cho xem
# được ngay bằng trình duyệt; lên production đổi thành 'r2'.
MEDIA_DISK=public
# Hàng đợi riêng cho việc nén ảnh và sinh thumbnail, tách khỏi 'default'.
MEDIA_QUEUE=media
# Hạn của đường dẫn ký (phút), dùng khi ổ đĩa không có địa chỉ công khai.
# Ngắn vì ai cầm được đường dẫn là xem được tệp mà không cần đăng nhập.
MEDIA_TEMPORARY_URL_DEFAULT_LIFETIME=30

# ── Mail ─────────────────────────────────────────────
# Mặc định trỏ vào Mailpit — hộp thư giả chạy trong Docker, đọc ở
# localhost:8025. Email KHÔNG rời khỏi máy, tiện khi dev.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="khong-tra-loi@explus.vn"
MAIL_FROM_NAME="${APP_NAME}"

# Gửi thật qua Gmail SMTP — điền vào .env của bạn, KHÔNG điền vào file này.
# MAIL_PASSWORD là "App Password" 16 ký tự (myaccount.google.com/apppasswords),
# không phải mật khẩu đăng nhập Gmail. MAIL_FROM_ADDRESS phải trùng
# MAIL_USERNAME, nếu không Gmail sẽ viết đè địa chỉ gửi.
#
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=ten-cua-ban@gmail.com
# MAIL_PASSWORD=matkhauung16kytu
# MAIL_FROM_ADDRESS="ten-cua-ban@gmail.com"

# ── Xác thực hai lớp ─────────────────────────────────
# email = gửi mã 6 số tới hộp thư. totp = ứng dụng xác thực (Google/Microsoft
# Authenticator). Đổi giá trị này là đổi kênh, không phải sửa mã nguồn.
TWO_FACTOR_DRIVER=email

# ── Ca làm chuẩn ─────────────────────────────────────
# Đây chỉ là MẶC ĐỊNH. Cách bình thường để đổi là trang Cài đặt trang trong
# ứng dụng (menu tài khoản → Cài đặt trang) — giá trị ở đó ghi đè các dòng này
# lúc khởi động, và giám đốc tự đổi được mà không cần vào máy chủ.
ATTENDANCE_SHIFT_MORNING_START=08:15
ATTENDANCE_SHIFT_LUNCH_START=12:00
ATTENDANCE_SHIFT_LUNCH_END=13:30
ATTENDANCE_SHIFT_END=17:30
ATTENDANCE_SHIFT_GRACE_MINUTES=0
